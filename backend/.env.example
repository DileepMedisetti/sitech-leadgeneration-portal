# Sitech Series Lead Generation Portal
# Never commit your actual .env file to Git.

# ==========================================
# POSTGRESQL DATABASE
# ==========================================
# Format: 
# postgresql+psycopg://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME

DATABASE_URL=postgresql+psycopg://postgres:YOUR_DATABASE_PASSWORD@localhost:5432/YOUR_DATABASE_NAME


# ==========================================
# SEARCH PROVIDER - SERPER.DEV
# ==========================================
# Serper.dev is the primary search provider.
# Leave SERPAPI_API_KEY empty if SerpApi is no longer used.

SERPAPI_API_KEY=
SERPER_API_KEY=YOUR_SERPER_API_KEY
SERPER_BASE_URL=https://google.serper.dev


# ==========================================
# JWT AUTHENTICATION
# ==========================================
# Generate a secret using:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# Paste the generated secret below.

JWT_SECRET_KEY=PASTE_YOUR_GENERATED_SECRET_HERE
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440


# ==========================================
# DEMO USER
# ==========================================
DEMO_USER_EMAIL=
DEMO_USER_NAME=


# ==========================================
# SMTP / EMAIL CONFIGURATION
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Sitech Series Lead Generation
SMTP_USE_TLS=true


# ==========================================
# CLOUDINARY
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# ==========================================
# APPLICATION ENVIRONMENT
# ==========================================
APP_ENV=development   # development, testing, production

# Enable only for local development when intentionally needed.
# Disables the development OTP console feature in Production. (False)
ENABLE_DEV_OTP_CONSOLE=true