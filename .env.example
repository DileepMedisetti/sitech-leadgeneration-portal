# Sitech Series Lead Generation Portal - Environment Configuration Template
# Copy this file to .env or backend/.env and provide your actual credentials. Never commit your real .env.

# PostgreSQL Connection String
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/sitech_leadgeneration_db

# Serper.dev API Key (Primary search provider; cached searches do not consume credits)
SERPER_API_KEY=your_serper_dev_api_key_here
SERPER_BASE_URL=https://google.serper.dev

# SerpApi API Key (legacy fallback)
SERPAPI_API_KEY=your_serpapi_api_key_here
